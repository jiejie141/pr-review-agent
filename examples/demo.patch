diff --git a/app/orders.py b/app/orders.py
--- a/app/orders.py
+++ b/app/orders.py
@@ -7,3 +7,25 @@
 
 def order_count():
     return 0
+
+
+def load_orders(user_ids):
+    rows = []
+    for uid in user_ids:
+        rows.append(repo.query(Order).get(uid))
+    return rows
+
+
+def render(rows):
+    out = ""
+    for row in rows:
+        out += str(row) + "\n"
+    return out
+
+
+def process(order_id, amount):
+    order = repo.get_order(order_id)
+    repo.save(order)
+    ledger.insert(order_id, amount)
+    requests.post(callback_url, json=order.payload)
+    return order
