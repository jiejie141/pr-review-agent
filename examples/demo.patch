+def find_user(conn, username):
+    cur = conn.cursor()
+    cur.execute("SELECT * FROM users WHERE name = '" + username + "'")
+    return cur.fetchone()
+
+
+def parse_token(token):
+    return jwt.decode(token, options={"verify_signature": False})
+
+
+def main():
+    app.run(host="0.0.0.0", debug=True)
