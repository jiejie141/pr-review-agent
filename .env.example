# ======================================================================
# PR 代码审查 Agent —— 环境变量示例
# 复制为 .env 后按需填写。**不要提交 .env 本身**（已在 .gitignore 中排除）
# ======================================================================

# ----------------------------------------------------------------------
# LLM（OpenAI 兼容协议）
# ----------------------------------------------------------------------
# 不填也能跑：加 --mock 使用内置离线替身，或 --rules-only 只跑规则库。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2

# 其他常见供应商（把上面三行换成对应值即可）：
#   DeepSeek    https://api.deepseek.com/v1              deepseek-chat
#   Moonshot    https://api.moonshot.cn/v1               moonshot-v1-8k
#   SiliconFlow https://api.siliconflow.cn/v1            Qwen/Qwen2.5-7B-Instruct
#   DashScope   https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   智谱        https://open.bigmodel.cn/api/paas/v4     glm-4-flash
#
# 只想用最便宜的模型跑通：把 LLM_MODEL 换成 xx-small / flash / turbo 之类的小模型，
# 本项目单次审查消耗通常在 3k~15k token。

# ----------------------------------------------------------------------
# GitHub
# ----------------------------------------------------------------------
# 需要读取 PR 或回写评论时必填。
# 最小权限：Fine-grained token，勾选 Contents: Read、Pull requests: Read and write
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# 可选：配置后用 MCP 通道读取 PR（写操作仍走直连 REST，可审计）
# 例：MCP_GITHUB_SERVER_CMD=python D:/tools/github-mcp-server/server.py
MCP_GITHUB_SERVER_CMD=

# ----------------------------------------------------------------------
# 审查策略
# ----------------------------------------------------------------------
# 仓库规范文档路径，多个用 ; 分隔（Windows）或 : 分隔（Linux/macOS）。
# 留空则自动使用 examples/conventions/ 下的示例。
CONVENTIONS_PATHS=

# 单个分片送给模型的最大字符数。太大容易触发「只读开头」，
# 太小会把一个函数的上下文切散。6000 是实测比较稳的值。
SHARD_MAX_CHARS=6000

# 单文件最多报几条意见。PR 上堆 40 条没人看完，密度反而下降。
MAX_FINDINGS_PER_FILE=6

# 整个 PR 最多审查多少个文件
MAX_FILES=60

# 最低报告级别：low / medium / high
MIN_SEVERITY=low

# 是否强制「无行号不评论」。关掉会显著提高幻觉意见被发出去的概率，
# 除非你明确知道自己在做什么，否则保持 true。
REQUIRE_LINE_ANCHOR=true
